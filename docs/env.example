# Example settings (no secrets). Rename/copy to apps/web/.env.local for the web app + backend.
# With no values set, everything runs locally in development mode:
# embedded database, demo sign-in, simulated messages, simulated routing.

# --- Mode ---
# development | production. Real SMS/calls are only possible when APP_ENV=production.
APP_ENV=development
BUSINESS_NAME=Demo Snow Co.
TIME_ZONE=America/Moncton
# Public address of the web app (used in status links and Twilio callbacks)
PUBLIC_BASE_URL=http://localhost:3100
# 32+ random characters. Required in production. Example: openssl rand -base64 48
SESSION_SECRET=
# Protects /api/jobs/scheduler. Required in production. Example: openssl rand -hex 32
CRON_SECRET=

# --- Database ---
# Empty = embedded local Postgres in .data/pglite (development only).
# Supabase: Project Settings > Database > Connection string (Transaction pooler, port 6543).
DATABASE_URL=

# --- Authentication ---
# dev = demo accounts on the sign-in screen (disabled in production)
# supabase = email + password through Supabase Auth
AUTH_MODE=dev
# Project Settings > API Keys. Legacy names SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only (sb_secret_...). Needed for sign-in accounts and private photo storage.
SUPABASE_SECRET_KEY=

# --- Photo storage ---
# local = .data/photos on this computer; supabase = private "visit-photos" bucket
STORAGE_MODE=local

# --- Messaging (Twilio) ---
# simulated = record messages, send nothing (always the case outside production)
# live = send real SMS and voice calls (needs APP_ENV=production and all values below)
MESSAGING_MODE=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio phone number in E.164 form, e.g. +15065550100 (needed for voice calls)
TWILIO_FROM_NUMBER=
# Optional, for SMS
TWILIO_MESSAGING_SERVICE_SID=

# --- Email (Resend) ---
# Service updates by email. Real email is sent only when APP_ENV=production, MESSAGING_MODE=live
# and both values below are set. Otherwise emails are simulated and labelled so.
RESEND_API_KEY=
# Sender, from a domain verified in Resend, e.g. Demo Snow Co. <updates@example.com>
EMAIL_FROM=
# Optional: where client replies go
EMAIL_REPLY_TO=

# --- Routing (Mapbox) ---
# mock = simulated locations and travel times (clearly labelled); mapbox = real road data
ROUTING_MODE=mock
MAPBOX_TOKEN=

# --- Address suggestions (Google Places) ---
# Optional. Shows address suggestions while you type a property address.
# This key is sent to the browser: in Google Cloud, allow only the Places API (New)
# and restrict it to your website addresses (e.g. http://localhost:3100/*, https://your-domain/*).
GOOGLE_MAPS_API_KEY=

# Default route start (depot)
DEFAULT_START_ADDRESS=Depot, 1 Industrial Dr, Moncton, NB
DEFAULT_START_LAT=46.1105
DEFAULT_START_LNG=-64.8024

# Set to true only if you self-host one server process and want it to run the scheduler itself.
RUN_SCHEDULER_IN_PROCESS=false
