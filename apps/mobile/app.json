{
  "expo": {
    "name": "Snow Removal",
    "slug": "snow-removal",
    "scheme": "snowremoval",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "bundleIdentifier": "com.example.snowremoval", "supportsTablet": false },
    "android": { "package": "com.example.snowremoval" },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      ["expo-image-picker", { "cameraPermission": "Take an optional photo of the driveway after service.", "photosPermission": "Attach an optional driveway photo." }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
